# Copied to .env by `make up`; edit .env, not this file.

# The SQLFlow image every role runs. v2026.10.03 is the first release with
# what this stack depends on (sql-flow #414): ack: after_flush, the Kafka sink
# key, partition_owned and the low-watermark commit. To try an unreleased
# SQLFlow, run `make sqlflow-image` and set SQLFLOW_IMAGE=sqlflow:dev here.
SQLFLOW_IMAGE=turbolytics/sql-flow:v2026.10.03

# Where the SQLFlow services find the infrastructure, on the compose network.
SQLFLOW_POSTGRES_URI=postgresql://metering:metering@postgres:5432/metering
SQLFLOW_KAFKA_BROKERS=kafka:9092
SQLFLOW_S3_ENDPOINT=rustfs:9000
SQLFLOW_S3_ACCESS_KEY_ID=rustfsadmin
SQLFLOW_S3_SECRET_ACCESS_KEY=rustfsadmin

# serve's client id. It identifies a caller; it does not authenticate one.
SQLFLOW_SERVE_CLIENT_ID=demo-console

# Host ports, for clients on your machine: psql, curl, the tests, a
# browser. Change these if something else on your machine already listens
# there; nothing inside the compose network uses them.
PG_HOST_PORT=5432
KAFKA_HOST_PORT=29092
S3_HOST_PORT=9000
INGEST_HOST_PORT=8001
S3_CONSOLE_HOST_PORT=9001
